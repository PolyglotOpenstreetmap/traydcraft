# Copy to .env (not committed), then load it before running the API:
#   set -a; source .env; set +a; cargo run -p traydcraft-api
DATABASE_URL=postgresql://traydcraft:traydcraft@localhost/traydcraft

# oidc (default) or dev. Dev trusts the X-Dev-User header: local development only.
AUTH_MODE=dev
DEV_DEFAULT_USER=
# For AUTH_MODE=oidc, e.g. Microsoft Entra ID:
#   OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   OIDC_AUDIENCE=<api application id>
OIDC_ISSUER=
OIDC_AUDIENCE=

SEED_DEV_DATA=true
BIND_ADDR=127.0.0.1:8080
TYPST_BIN=typst
TEMPLATE_DIR=templates

# Worker (cargo run -p traydcraft-worker)
MAIL_TRANSPORT=files
MAIL_FILES_DIR=outbox
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls   # starttls | tls | none (none only for a local test server)
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_TLS=true            # false only for a local test server
# HELPDESK_COMPANY_ID=
POLL_SECONDS=30

            "format": "int32"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "postal_code": {
            "type": "string"
          },
          "price_zone_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_zone_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "street": {
            "type": "string"
          },
          "vat_number": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CustomerInput": {
        "type": "object",
        "required": [
          "code",
          "name",
          "price_zone_id"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "city": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "discount_percent": {
            "type": "string",
            "example": "0"

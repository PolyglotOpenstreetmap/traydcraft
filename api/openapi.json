          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "language": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "payment_terms_days": {
